<?xml version="1.0" encoding="utf-8"?>
<!--
    CoinLens launcher foreground.
    Vector port of AppLogoIcon (MainActivity.kt) so the home-screen / dock icon
    has the same bright coral 'C' + emerald 'L', chart bars, trend arrow and glow
    as the in-app header logo.
    Paths are authored in a 0..100 logo space (same proportions as the Compose
    Canvas) and scaled into the 108dp adaptive-icon safe zone by the group.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.57"
        android:scaleY="0.57"
        android:translateX="27.21"
        android:translateY="25.5">

        <!-- ===================== 1. CORAL 'C' ===================== -->

        <!-- Extra wide soft halo (boost for small launcher size) -->
        <path
            android:fillColor="#00000000"
            android:pathData="M72.24,78.10 A38,42 0 1,1 67.40,16.90"
            android:strokeWidth="27"
            android:strokeColor="#1AE38391"
            android:strokeLineCap="round" />

        <!-- Soft outer coral glow (matches header: alpha 0.18, 1.65x) -->
        <path
            android:fillColor="#00000000"
            android:pathData="M72.24,78.10 A38,42 0 1,1 67.40,16.90"
            android:strokeWidth="18.98"
            android:strokeColor="#2EE38391"
            android:strokeLineCap="round" />

        <!-- Main tubular 'C' body -->
        <path
            android:fillColor="#00000000"
            android:pathData="M72.24,78.10 A38,42 0 1,1 67.40,16.90"
            android:strokeWidth="13.57"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="0"
                    android:endX="80"
                    android:endY="100">
                    <item android:offset="0.0" android:color="#FFF5A3B0" />
                    <item android:offset="0.5" android:color="#FFE38391" />
                    <item android:offset="1.0" android:color="#FFB84A5A" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Inner glass core refraction -->
        <path
            android:fillColor="#00000000"
            android:pathData="M70.40,80.21 A38,42 0 1,1 65.25,15.18"
            android:strokeWidth="5.52"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="0"
                    android:endX="70"
                    android:endY="100">
                    <item android:offset="0.0" android:color="#CCFFDCE2" />
                    <item android:offset="0.5" android:color="#40E38391" />
                    <item android:offset="1.0" android:color="#A6FFC4CE" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Bright specular highlight along upper-left curve -->
        <path
            android:fillColor="#00000000"
            android:pathData="M12.29,70.31 A36.62,40.62 0 0,1 28.52,13.19"
            android:strokeWidth="2.07"
            android:strokeColor="#A6FFFFFF"
            android:strokeLineCap="round" />

        <!-- ===================== 2. EMERALD 'L' ===================== -->

        <path
            android:fillColor="#00000000"
            android:pathData="M58,45 L40,68 L82,68"
            android:strokeWidth="17"
            android:strokeColor="#1A34D399"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <path
            android:fillColor="#00000000"
            android:pathData="M58,45 L40,68 L82,68"
            android:strokeWidth="12.08"
            android:strokeColor="#3334D399"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <path
            android:fillColor="#00000000"
            android:pathData="M58,45 L40,68 L82,68"
            android:strokeWidth="8.28"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="35"
                    android:startY="15"
                    android:endX="90"
                    android:endY="75">
                    <item android:offset="0.0" android:color="#FF7CF5CC" />
                    <item android:offset="0.5" android:color="#FF34D399" />
                    <item android:offset="1.0" android:color="#FF1E7A5C" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:fillColor="#00000000"
            android:pathData="M58,45 L40,68 L82,68"
            android:strokeWidth="2.07"
            android:strokeColor="#BFD8FFF0"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- ===================== 3. CHART BARS ===================== -->

        <!-- Small bar -->
        <path android:pathData="M56.8,53 h0.6 a2.8,2.8 0 0 1 2.8,2.8 v3.4 a2.8,2.8 0 0 1 -2.8,2.8 h-0.6 a2.8,2.8 0 0 1 -2.8,-2.8 v-3.4 a2.8,2.8 0 0 1 2.8,-2.8 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="35"
                    android:startY="15"
                    android:endX="90"
                    android:endY="75">
                    <item android:offset="0.0" android:color="#FF7CF5CC" />
                    <item android:offset="0.5" android:color="#FF34D399" />
                    <item android:offset="1.0" android:color="#FF1E7A5C" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Medium bar -->
        <path android:pathData="M65.8,45 h1.2 a2.8,2.8 0 0 1 2.8,2.8 v11.4 a2.8,2.8 0 0 1 -2.8,2.8 h-1.2 a2.8,2.8 0 0 1 -2.8,-2.8 v-11.4 a2.8,2.8 0 0 1 2.8,-2.8 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="35"
                    android:startY="15"
                    android:endX="90"
                    android:endY="75">
                    <item android:offset="0.0" android:color="#FF7CF5CC" />
                    <item android:offset="0.5" android:color="#FF34D399" />
                    <item android:offset="1.0" android:color="#FF1E7A5C" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Tall glossy bar -->
        <path android:pathData="M76.5,34 h1.5 a4,4 0 0 1 4,4 v20 a4,4 0 0 1 -4,4 h-1.5 a4,4 0 0 1 -4,-4 v-20 a4,4 0 0 1 4,-4 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="35"
                    android:startY="15"
                    android:endX="90"
                    android:endY="75">
                    <item android:offset="0.0" android:color="#FF7CF5CC" />
                    <item android:offset="0.5" android:color="#FF34D399" />
                    <item android:offset="1.0" android:color="#FF1E7A5C" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:fillColor="#00000000"
            android:pathData="M77,35.5 h0.5 a3,3 0 0 1 3,3 v19 a3,3 0 0 1 -3,3 h-0.5 a3,3 0 0 1 -3,-3 v-19 a3,3 0 0 1 3,-3 z"
            android:strokeWidth="1.5"
            android:strokeColor="#BFD8FFF0" />

        <!-- ===================== 4. TREND ARROW ===================== -->

        <path
            android:fillColor="#00000000"
            android:pathData="M52,38 L60,29 L66,34 L86,15"
            android:strokeWidth="18"
            android:strokeColor="#1A34D399"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <path
            android:fillColor="#00000000"
            android:pathData="M52,38 L60,29 L66,34 L86,15"
            android:strokeWidth="13.23"
            android:strokeColor="#3834D399"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <path
            android:fillColor="#00000000"
            android:pathData="M52,38 L60,29 L66,34 L86,15"
            android:strokeWidth="8.74"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="35"
                    android:startY="15"
                    android:endX="90"
                    android:endY="75">
                    <item android:offset="0.0" android:color="#FF7CF5CC" />
                    <item android:offset="0.5" android:color="#FF34D399" />
                    <item android:offset="1.0" android:color="#FF1E7A5C" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:fillColor="#00000000"
            android:pathData="M52,38 L60,29 L66,34 L86,15"
            android:strokeWidth="2.3"
            android:strokeColor="#BFD8FFF0"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- Arrowhead -->
        <path android:pathData="M90,11 L73,14 L86,27 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="35"
                    android:startY="15"
                    android:endX="90"
                    android:endY="75">
                    <item android:offset="0.0" android:color="#FF7CF5CC" />
                    <item android:offset="0.5" android:color="#FF34D399" />
                    <item android:offset="1.0" android:color="#FF1E7A5C" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:fillColor="#00000000"
            android:pathData="M90,11 L73,14 L86,27 Z"
            android:strokeWidth="1.61"
            android:strokeColor="#BFD8FFF0"
            android:strokeLineJoin="round" />
    </group>
</vector>
